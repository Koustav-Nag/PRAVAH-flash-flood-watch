# Copy this to .env and fill in once you have GEE credentials.
# Without these, the system runs entirely on mock data (safe for dev/demo).

# GEE Authentication credentials template
GEE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
GEE_SERVICE_ACCOUNT_KEY_PATH=/path/to/your/key.json
GEE_PROJECT_ID=your-project-id
